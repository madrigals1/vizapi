<svg width="{{width}}" height="{{height}}" xmlns="http://www.w3.org/2000/svg">
  <rect width="{{width}}" height="{{height}}" fill="#fff"/>
  <rect x="{{tableX}}" y="{{headerY}}" width="{{tableW}}" height="{{headerH}}" fill="#f5f5f5" stroke="#ddd" stroke-width="1"/>
  <rect x="{{tableX}}" y="{{headerY}}" width="{{tableW}}" height="{{tableH}}" fill="none" stroke="#ddd" stroke-width="1"/>
  {{#each headers}}
  <text x="{{x}}" y="{{y}}" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#333">{{text}}</text>
  {{/each}}
  {{#each rows}}
  <rect x="{{../tableX}}" y="{{y}}" width="{{../tableW}}" height="{{rowH}}" fill="{{bg}}"/>
  {{#each cells}}
  <text x="{{x}}" y="{{ty}}" font-family="Arial,sans-serif" font-size="13" fill="#333">{{text}}</text>
  {{/each}}
  {{#if showBorder}}
  <line x1="{{../tableX}}" y1="{{y2}}" x2="{{../tableXPlusW}}" y2="{{y2}}" stroke="#ddd" stroke-width="1"/>
  {{/if}}
  {{/each}}
</svg>
