<svg width="{{width}}" height="{{height}}" xmlns="http://www.w3.org/2000/svg">
  <rect width="{{width}}" height="{{height}}" fill="#f5f5f5"/>
  {{#each cards}}
  <rect x="{{cx}}" y="15" width="{{cardW}}" height="{{cardH}}" rx="4" fill="#fff" stroke="#ddd" stroke-width="1"/>
  <image x="{{ix}}" y="25" width="250" height="250" preserveAspectRatio="xMidYMid meet" href="{{image}}"/>
  {{#each bioFields}}
  <text x="{{bx}}" y="{{by}}" font-family="Segoe UI,Arial,sans-serif" font-size="14" font-weight="bold" fill="#333">{{name}}</text>
  <text x="{{bvx}}" y="{{by}}" font-family="Segoe UI,Arial,sans-serif" font-size="14" fill="#666" text-anchor="end">{{value}}</text>
  {{/each}}
  <line x1="{{cx}}" y1="{{dividerY}}" x2="{{cx2}}" y2="{{dividerY}}" stroke="#e0e0e0" stroke-width="1"/>
  {{#each compareFields}}
  <circle cx="{{cx}}" cy="{{cy}}" r="8" fill="{{dotColor}}"/>
  <text x="{{nx}}" y="{{ny}}" font-family="Segoe UI,Arial,sans-serif" font-size="16" font-weight="{{nw}}" fill="{{nc}}" text-anchor="{{na}}">{{name}}</text>
  <text x="{{vx}}" y="{{ny}}" font-family="Segoe UI,Arial,sans-serif" font-size="16" fill="{{vc}}" text-anchor="{{va}}">{{value}}</text>
  {{/each}}
  {{/each}}
</svg>
