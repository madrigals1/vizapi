<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DejaVu Sans', 'Noto Color Emoji', Arial, sans-serif; }
</style>
</head>
<body>
  <div style="display:flex;flex-direction:row;gap:{{gap}}px;padding:{{padding}}px;background-color:#f5f5f5;width:{{width}}px;">
    {{#each cards}}
    <div style="width:{{../cardW}}px;background-color:#ffffff;border-radius:4px;border:1px solid #dddddd;overflow:hidden;">
      <div style="display:flex;padding:15px;gap:15px;">
        <img src="{{image}}" width="{{../imageSize}}" height="{{../imageSize}}" style="object-fit:cover;border-radius:4px;" alt="">
        <div style="display:flex;flex-direction:column;justify-content:flex-start;flex:1;">
          {{#each bioFields}}
          <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
            <span style="font-weight:bold;font-size:14px;color:#333333;">{{name}}</span>
            <span style="font-size:14px;color:#666666;text-align:right;">{{value}}</span>
          </div>
          {{/each}}
        </div>
      </div>
      <div style="border-top:1px solid #e0e0e0;margin:0 15px;"></div>
      <div style="padding:10px 15px;">
        {{#each compareFields}}
        <div style="display:flex;align-items:center;margin-bottom:12px;background-image:linear-gradient(to {{direction}}, rgba({{r}},{{g}},{{b}},0.4), transparent);border-radius:4px;padding:8px 12px;">
          <span style="font-weight:bold;font-size:16px;color:#333333;">{{#if leftSide}}{{name}}{{else}}{{value}}{{/if}}</span>
          <div style="flex:1;"></div>
          <span style="font-weight:bold;font-size:16px;color:#333333;">{{#if leftSide}}{{value}}{{else}}{{name}}{{/if}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
</body>
</html>
