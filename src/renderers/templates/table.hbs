<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DejaVu Sans', Arial, sans-serif; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; }
  th, td { border-bottom: 1px solid #dddddd; }
</style>
</head>
<body>
  <div style="width:{{width}}px;padding:{{padding}}px;background-color:#ffffff;">
    <table>
      <colgroup>
        {{#each colWidths}}<col style="width:{{this}}px;min-width:{{this}}px;max-width:{{this}}px;">{{/each}}
      </colgroup>
      <thead>
        <tr style="background-color:#f5f5f5;">
          {{#each columns}}<th style="{{../headerStyle}}">{{this}}</th>{{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr style="background-color:{{bg}};">
          {{#each cells}}<td style="{{../../cellStyle}}">{{this}}</td>{{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</body>
</html>
