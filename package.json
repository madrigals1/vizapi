{
  "name": "vizapi",
  "version": "1.0.0",
  "description": "API for visualizing Data",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.json && cp src/renderers/templates/*.hbs dist/renderers/templates/",
    "start": "npx tsx watch src/app.ts",
    "lint": "eslint --fix 'src/**/*.ts'",
    "test": "npx tsx scripts/test-api.ts"
  },
