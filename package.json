  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "echarts": "^6.1.0",
    "fastify": "^5.6.2",
    "handlebars": "^4.7.9",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/handlebars": "^4.0.40",
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.65.0"
  }
